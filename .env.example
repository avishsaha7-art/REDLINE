# REDLINE Model Provider Configuration Template (Placeholders only)
# Do not place real credentials or secrets in this file.

# Explicit Provider Selection: 'nebius', 'freellmapi', or 'deterministic'
# Defaults to auto-detection (Nebius -> FreeLLMAPI -> Deterministic mock) if unset.
REDLINE_MODEL_PROVIDER=deterministic

# Nebius Token Factory Configuration
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
NEBIUS_MAX_RESPONSE_BYTES=1048576

# FreeLLMAPI Local Gateway Configuration
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_MAX_RESPONSE_BYTES=1048576
