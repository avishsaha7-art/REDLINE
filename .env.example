# REDLINE Model Provider Configuration Template (Placeholders only)
# Do not place real credentials or secrets in this file.

# Explicit Provider Selection: 'nebius', 'freellmapi', or 'deterministic'
# Default: nebius
REDLINE_MODEL_PROVIDER=nebius

# Nebius Token Factory Configuration (Default Primary Provider)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_MAX_RESPONSE_BYTES=1048576

# FreeLLMAPI Local Gateway Configuration (Optional Secondary Provider)
# Official repository: https://github.com/tashfeenahmed/freellmapi
# Local gateway endpoint (OpenAI-compatible):
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_MODEL=auto
FREELLMAPI_MAX_RESPONSE_BYTES=1048576

# Frontend API URL
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
